{
  "expo": {
    "name": "Nyurix",
    "slug": "nutri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nyurix",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nyurix.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nyurix needs camera access to scan and analyze your food",
        "NSPhotoLibraryUsageDescription": "Nyurix needs photo library access to analyze food photos",
        "NSMotionUsageDescription": "Nyurix uses your phone's step counter to track your daily activity and sync it to your account.",
        "LSApplicationQueriesSchemes": [
          "instagram-stories"
        ]
      }
    },
    "android": {
      "package": "com.nyurix.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS"
      ],
      "blockedPermissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withInstagramQueries",
      "./plugins/withScopedStoragePermissions",
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Nyurix needs camera access to scan and analyze your food"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Nyurix needs access to your photo library to save story cards",
          "savePhotosPermission": "Nyurix needs permission to save your nutrition story cards",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-audio",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2819942e-894e-4b23-be30-330ba07da68f"
      }
    }
  }
}
